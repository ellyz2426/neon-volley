<style>
  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 3;
    padding-bottom: 3;
    padding-left: 4;
    padding-right: 4;
    background-color: rgba(0, 10, 30, 0.92);
    border-color: #00ffff;
    border-width: 0.15;
    border-radius: 1.5;
    gap: 1.5;
  }
  .heading {
    font-size: 3;
    color: #00ffff;
    font-weight: bold;
  }
  .row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1;
  }
  .label {
    font-size: 1.5;
    color: #88ccff;
  }
  .value {
    font-size: 1.5;
    color: #ffffff;
    font-weight: bold;
  }
  .btn-ctrl {
    padding-top: 0.5;
    padding-bottom: 0.5;
    padding-left: 1;
    padding-right: 1;
    background-color: rgba(0, 180, 255, 0.2);
    border-color: #00ffff;
    border-width: 0.08;
    border-radius: 0.4;
    cursor: pointer;
  }
  .ctrl-text {
    font-size: 1.5;
    color: #00ffff;
  }
  .back-btn {
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 2;
    padding-right: 2;
    background-color: rgba(100, 100, 100, 0.2);
    border-color: #666666;
    border-width: 0.08;
    border-radius: 0.6;
    cursor: pointer;
  }
  .back-text {
    font-size: 1.4;
    color: #888888;
  }
</style>
<div class="panel">
  <span class="heading">SETTINGS</span>
  <div class="row">
    <span class="label">SFX:</span>
    <div id="btn-sfx-down" class="btn-ctrl"><span class="ctrl-text">-</span></div>
    <span id="sfx-val" class="value">70%</span>
    <div id="btn-sfx-up" class="btn-ctrl"><span class="ctrl-text">+</span></div>
  </div>
  <div class="row">
    <span class="label">Music:</span>
    <div id="btn-music-down" class="btn-ctrl"><span class="ctrl-text">-</span></div>
    <span id="music-val" class="value">30%</span>
    <div id="btn-music-up" class="btn-ctrl"><span class="ctrl-text">+</span></div>
  </div>
  <div class="row">
    <span class="label">Theme:</span>
    <div id="btn-theme-prev" class="btn-ctrl"><span class="ctrl-text">&lt;</span></div>
    <span id="theme-val" class="value">HOLODECK</span>
    <div id="btn-theme-next" class="btn-ctrl"><span class="ctrl-text">&gt;</span></div>
  </div>
  <div class="row">
    <span class="label">Ball:</span>
    <div id="btn-ball-prev" class="btn-ctrl"><span class="ctrl-text">&lt;</span></div>
    <span id="ball-val" class="value">NEON</span>
    <div id="btn-ball-next" class="btn-ctrl"><span class="ctrl-text">&gt;</span></div>
  </div>
  <div class="row">
    <span class="label">Wind:</span>
    <div id="btn-wind-toggle" class="btn-ctrl"><span id="wind-val" class="ctrl-text">ON</span></div>
  </div>
  <div id="btn-back" class="back-btn"><span class="back-text">BACK</span></div>
</div>
