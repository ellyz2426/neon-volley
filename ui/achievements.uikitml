<style>
  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 3;
    padding-right: 3;
    background-color: rgba(0, 10, 30, 0.92);
    border-color: #ffd700;
    border-width: 0.15;
    border-radius: 1.5;
    gap: 0.5;
  }
  .heading {
    font-size: 3;
    color: #ffd700;
    font-weight: bold;
  }
  .count {
