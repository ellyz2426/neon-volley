<style>
  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 3;
    padding-bottom: 3;
    padding-left: 4;
    padding-right: 4;
    background-color: rgba(0, 10, 30, 0.92);
    border-color: #00ffff;
    border-width: 0.15;
    border-radius: 1.5;
    gap: 2;
  }
  .title-text {
    font-size: 5;
    color: #00ffff;
    font-weight: bold;
  }
  .subtitle {
    font-size: 1.8;
    color: #88ccff;
  }
  .btn {
    padding-top: 1;
    padding-bottom: 1;
    padding-left: 3;
    padding-right: 3;
    background-color: rgba(0, 180, 255, 0.2);
    border-color: #00ffff;
    border-width: 0.1;
    border-radius: 0.8;
    cursor: pointer;
  }
  .btn-text {
    font-size: 2;
    color: #00ffff;
    font-weight: bold;
  }
  .btn-row {
    display: flex;
    flex-direction: row;
    gap: 1.5;
  }
  .btn-small {
    padding-top: 0.8;
    padding-bottom: 0.8;
    padding-left: 2;
    padding-right: 2;
    background-color: rgba(0, 180, 255, 0.15);
    border-color: #00aacc;
    border-width: 0.08;
    border-radius: 0.6;
    cursor: pointer;
  }
  .btn-small-text {
    font-size: 1.5;
    color: #88ddff;
  }
</style>
<div class="panel">
  <span class="title-text">NEON VOLLEY</span>
  <span class="subtitle">Holodeck Beach Volleyball</span>
  <div id="btn-play" class="btn"><span class="btn-text">PLAY</span></div>
  <div class="btn-row">
    <div id="btn-leaderboard" class="btn-small"><span class="btn-small-text">LEADERBOARD</span></div>
    <div id="btn-stats" class="btn-small"><span class="btn-small-text">STATS</span></div>
  </div>
  <div id="btn-achievements" class="btn-small"><span class="btn-small-text">ACHIEVEMENTS</span></div>
  <div id="btn-settings" class="btn-small"><span class="btn-small-text">SETTINGS</span></div>
  <div id="btn-help" class="btn-small"><span class="btn-small-text">HELP</span></div>
</div>
