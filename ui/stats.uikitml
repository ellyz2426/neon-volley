<style>
  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 3;
    padding-bottom: 3;
    padding-left: 4;
    padding-right: 4;
    background-color: rgba(0, 10, 30, 0.92);
    border-color: #00ffff;
    border-width: 0.15;
    border-radius: 1.5;
    gap: 1.5;
  }
  .title {
    font-size: 3.5;
    color: #00ffff;
    font-weight: bold;
  }
  .stat-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    padding-left: 1;
    padding-right: 1;
  }
  .stat-label {
    font-size: 1.6;
    color: #88ccff;
  }
  .stat-value {
    font-size: 1.6;
    color: #ffffff;
    font-weight: bold;
  }
  .divider {
    width: 100%;
    height: 0.08;
    background-color: rgba(0, 180, 255, 0.3);
  }
  .btn {
    padding-top: 1;
    padding-bottom: 1;
    padding-left: 3;
    padding-right: 3;
    background-color: rgba(0, 180, 255, 0.2);
    border-color: #00ffff;
    border-width: 0.1;
    border-radius: 0.8;
    cursor: pointer;
  }
  .btn-text {
    font-size: 1.8;
    color: #00ffff;
    font-weight: bold;
  }
</style>
<div class="panel">
  <span class="title">CAREER STATS</span>
  <div class="divider"></div>
  <div class="stat-row"><span class="stat-label">Games Played</span><span id="stat-games" class="stat-value">0</span></div>
  <div class="stat-row"><span class="stat-label">Games Won</span><span id="stat-wins" class="stat-value">0</span></div>
  <div class="stat-row"><span class="stat-label">Win Rate</span><span id="stat-winrate" class="stat-value">0%</span></div>
  <div class="divider"></div>
  <div class="stat-row"><span class="stat-label">Total Aces</span><span id="stat-aces" class="stat-value">0</span></div>
  <div class="stat-row"><span class="stat-label">Total Spikes</span><span id="stat-spikes" class="stat-value">0</span></div>
  <div class="stat-row"><span class="stat-label">Total Blocks</span><span id="stat-blocks" class="stat-value">0</span></div>
  <div class="stat-row"><span class="stat-label">Best Rally</span><span id="stat-rally" class="stat-value">0</span></div>
  <div class="divider"></div>
  <div class="stat-row"><span class="stat-label">Achievements</span><span id="stat-achcount" class="stat-value">0/40</span></div>
  <div class="stat-row"><span class="stat-label">Career Points</span><span id="stat-career" class="stat-value">0</span></div>
  <div class="stat-row"><span class="stat-label">Modes Played</span><span id="stat-modes" class="stat-value">0/7</span></div>
  <div id="btn-back" class="btn"><span class="btn-text">BACK</span></div>
</div>
